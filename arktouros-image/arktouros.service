[Unit]
Description=Arktouros Apm Service
After=network.target

[Service]
WorkingDirectory=/usr/local/arktouros-apm-api
# Java 启动命令
ExecStart=/usr/local/jdk-21/bin/java -Dfile.encoding=UTF-8 -jar /usr/local/arktouros-apm-api/arktouros-apm-api-0.0.1.jar
ExecStop=/bin/kill -s SIGTERM $MAINPID
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
